# ---- Required. The server refuses to start without these. ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_OR_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=5050
FRONTEND_URL=http://localhost:5173

# ---- AI inference service ----
# Shared secret. Must match ai/.env exactly.
# Generate with: openssl rand -hex 32
# Without it, disease detection is disabled (the service fails closed).
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=

# ---- Cloudflare R2 (crop photo storage) ----
# Optional. Without it, diagnoses are still recorded but photos are not kept.
# Zero egress fees at any volume - the deciding factor for a photo-heavy app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=farmsense-images
# Public r2.dev or custom-domain binding. Without it we fall back to presigned
# URLs, which work but hit R2 on every image view.
R2_PUBLIC_BASE_URL=

# ---- Copernicus Data Space Ecosystem (Sentinel-1 / Sentinel-2) ----
# Optional but important: without it there is NO satellite correction, and every
# crop state will honestly report low confidence.
# Free registration at https://dataspace.copernicus.eu
# NOT Google Earth Engine - GEE's free tier excludes commercial/operational use.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- Region calibration ----
# Selects backend/src/modules/rules/regions/<name>.json
DEFAULT_REGION=siraha
