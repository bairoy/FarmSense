{
  "compilerOptions": {
    // Node 24 runs .ts directly via type stripping, so we never emit - tsc is
    // used purely as a checker here.
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "scratch"]
}
