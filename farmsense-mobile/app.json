{
  "expo": {
    "name": "FarmSense",
    "slug": "farmsense-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/farmsense_app.png",
    "scheme": "farmsensemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/farmsense_app.png",
      "bundleIdentifier": "com.farmsense.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.farmsense.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/farmsense_app.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F9F6",
          "image": "./assets/images/farmsense_app.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "FarmSense uses the camera to photograph crop leaves for disease diagnosis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FarmSense uses your photo library so you can choose an existing leaf photo to diagnose."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FarmSense uses your location to place a new field on the map at your current position."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9472ce5-64e1-46a8-9f0f-ce101d864e0d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c9472ce5-64e1-46a8-9f0f-ce101d864e0d"
    }
  }
}
