# Shared secret the Node backend presents on every inference call.
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Optional: URL to download rice_model.pth on first run (e.g. a public R2 object).
# Leave blank if rice_model.pth is already in ai/models/rice_v2/.
MODEL_URL=

# Below this softmax probability no treatment is recommended.
CONFIDENCE_GATE=0.65

# Storage compression
MAX_IMAGE_EDGE_PX=1000
JPEG_QUALITY=75
MAX_UPLOAD_BYTES=12582912

# Where the Node backend lives (used by the agent tool layer)
BACKEND_URL=http://localhost:5050

# OpenAI API for the chat agent (LangGraph)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
